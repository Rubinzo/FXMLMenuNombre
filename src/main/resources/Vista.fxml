<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.FormularioController"
      spacing="10"
      alignment="CENTER">

    <Label text="Registro de Productos" styleClass="title"/>

    <TextField fx:id="txtNombre" promptText="Nombre" />
    <TextField fx:id="txtPrecio" promptText="Precio" />
    <TextField fx:id="txtLocal" promptText="Local" />

    <Button text="Enviar" onAction="#accionBoton" />

    <ListView fx:id="listaEntradas"/>



</VBox>